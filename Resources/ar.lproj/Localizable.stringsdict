<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>alert.apps.question</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@appCount@&#10;&#10;%@</string>
        <key>appCount</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>zero</key>
            <string>لا توجد تطبيقات لإنهائها (%d).</string>
            <key>one</key>
            <string>هل تريد إنهاء التطبيق التالي (%d)؟</string>
            <key>two</key>
            <string>هل تريد إنهاء التطبيقين التاليين (%d)؟</string>
            <key>few</key>
            <string>هل تريد إنهاء التطبيقات التالية وعددها %d؟</string>
            <key>many</key>
            <string>هل تريد إنهاء التطبيقات التالية وعددها %d؟</string>
            <key>other</key>
            <string>هل تريد إنهاء التطبيقات التالية وعددها %d؟</string>
        </dict>
    </dict>
    <key>alert.quitAppsToRight.question</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@appCount@&#10;&#10;%@</string>
        <key>appCount</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>zero</key>
            <string>لا توجد تطبيقات على اليمين لإنهائها (%d).</string>
            <key>one</key>
            <string>هل تريد إنهاء التطبيق التالي على اليمين (%d)؟</string>
            <key>two</key>
            <string>هل تريد إنهاء التطبيقين التاليين على اليمين (%d)؟</string>
            <key>few</key>
            <string>هل تريد إنهاء التطبيقات التالية على اليمين وعددها %d؟</string>
            <key>many</key>
            <string>هل تريد إنهاء التطبيقات التالية على اليمين وعددها %d؟</string>
            <key>other</key>
            <string>هل تريد إنهاء التطبيقات التالية على اليمين وعددها %d؟</string>
        </dict>
    </dict>
    <key>taskbar.quitClosedApps</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@closedAppCount@</string>
        <key>closedAppCount</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>zero</key>
            <string>لا توجد تطبيقات مغلقة لإنهائها (%d)</string>
            <key>one</key>
            <string>إنهاء %d تطبيق مغلق</string>
            <key>two</key>
            <string>إنهاء %d تطبيقين مغلقين</string>
            <key>few</key>
            <string>إنهاء %d تطبيقات مغلقة</string>
            <key>many</key>
            <string>إنهاء %d تطبيقًا مغلقًا</string>
            <key>other</key>
            <string>إنهاء %d تطبيقات مغلقة</string>
        </dict>
    </dict>
</dict>
</plist>
