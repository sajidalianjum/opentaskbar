<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>alert.apps.question</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@appCount@&#10;&#10;%@</string>
        <key>appCount</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>Voulez-vous vraiment quitter l’app suivante (%d) ?</string>
            <key>other</key>
            <string>Voulez-vous vraiment quitter les %d apps suivantes ?</string>
        </dict>
    </dict>
    <key>alert.quitAppsToRight.question</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@appCount@&#10;&#10;%@</string>
        <key>appCount</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>Voulez-vous quitter l’app suivante (%d) ?</string>
            <key>other</key>
            <string>Voulez-vous quitter les %d apps suivantes ?</string>
        </dict>
    </dict>
    <key>taskbar.quitClosedApps</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@closedAppCount@</string>
        <key>closedAppCount</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>Quitter %d app fermée</string>
            <key>other</key>
            <string>Quitter %d apps fermées</string>
        </dict>
    </dict>
</dict>
</plist>
