<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>alert.apps.question</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@appCount@&#10;&#10;%@</string>
        <key>appCount</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>کیا آپ درج ذیل %d ایپ بند کرنا چاہتے ہیں؟</string>
            <key>other</key>
            <string>کیا آپ درج ذیل %d ایپس بند کرنا چاہتے ہیں؟</string>
        </dict>
    </dict>
    <key>alert.quitAppsToRight.question</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@appCount@&#10;&#10;%@</string>
        <key>appCount</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>کیا آپ دائیں جانب کی درج ذیل %d ایپ بند کرنا چاہتے ہیں؟</string>
            <key>other</key>
            <string>کیا آپ دائیں جانب کی درج ذیل %d ایپس بند کرنا چاہتے ہیں؟</string>
        </dict>
    </dict>
    <key>taskbar.quitClosedApps</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@closedAppCount@</string>
        <key>closedAppCount</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d بند ایپ بند کریں</string>
            <key>other</key>
            <string>%d بند ایپس بند کریں</string>
        </dict>
    </dict>
</dict>
</plist>
